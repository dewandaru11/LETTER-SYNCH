from pathlib import Path
from docx import Document
from datetime import datetime
import subprocess


BASE_DIR = Path(__file__).resolve().parent.parent

TEMPLATE_DIR = BASE_DIR / "templates"
OUTPUT_DIR = BASE_DIR / "output"

WORD_DIR = OUTPUT_DIR / "word"
PDF_DIR = OUTPUT_DIR / "pdf"


def _replace_in_paragraph(paragraph, replacements):

    for old, new in replacements.items():

        new = str(new or "")

        for run in paragraph.runs:

            if old in run.text:
                run.text = run.text.replace(
                    old,
                    new
                )

        full_text = paragraph.text

        if old in full_text:

            new_text = full_text.replace(
                old,
                new
            )

            if paragraph.runs:

                paragraph.runs[0].text = new_text

                for run in paragraph.runs[1:]:
                    run.text = ""


def _replace_everywhere(doc, replacements):

    for paragraph in doc.paragraphs:

        _replace_in_paragraph(
            paragraph,
            replacements
        )

    for table in doc.tables:

        for row in table.rows:

            for cell in row.cells:

                for paragraph in cell.paragraphs:

                    _replace_in_paragraph(
                        paragraph,
                        replacements
                    )

    for section in doc.sections:

        for paragraph in section.header.paragraphs:

            _replace_in_paragraph(
                paragraph,
                replacements
            )

        for table in section.header.tables:

            for row in table.rows:

                for cell in row.cells:

                    for paragraph in cell.paragraphs:

                        _replace_in_paragraph(
                            paragraph,
                            replacements
                        )

        for paragraph in section.footer.paragraphs:

            _replace_in_paragraph(
                paragraph,
                replacements
            )

        for table in section.footer.tables:

            for row in table.rows:

                for cell in row.cells:

                    for paragraph in cell.paragraphs:

                        _replace_in_paragraph(
                            paragraph,
                            replacements
                        )


def _replace_cell_text(cell, new_text):

    new_text = str(new_text or "")

    if not cell.paragraphs:

        cell.text = new_text
        return

    paragraph = cell.paragraphs[0]

    if paragraph.runs:

        paragraph.runs[0].text = new_text

        for run in paragraph.runs[1:]:

            run.text = ""

    else:

        paragraph.add_run(new_text)


def _cell_text(cell):

    return " ".join(
        line.strip()
        for line in cell.text.splitlines()
        if line.strip()
    )


def _find_table_with_header(doc):

    required = [
        "No",
        "Hari/Tanggal",
        "Jam Mulai Lembur",
        "Jam Selesai Lembur",
        "Jumlah Jam Lembur",
        "Laporan Lembur",
    ]

    for table in doc.tables:

        for row_index, row in enumerate(table.rows):

            texts = [
                _cell_text(cell).lower()
                for cell in row.cells
            ]

            combined = " | ".join(texts)

            score = 0

            for item in required:

                if item.lower() in combined:
                    score += 1

            if score >= 4:

                return table, row_index

    return None, None


def _remove_row(row):

    tbl = row._tr

    tbl.getparent().remove(tbl)



def _set_lembur_table_borders(table):
    """Memastikan semua garis tabel lembur tampil di Word."""

    from docx.oxml import OxmlElement
    from docx.oxml.ns import qn

    tbl = table._tbl
    tblPr = tbl.tblPr

    # Hapus konfigurasi border lama jika ada.
    old_borders = tblPr.find(qn("w:tblBorders"))

    if old_borders is not None:
        tblPr.remove(old_borders)

    tbl_borders = OxmlElement("w:tblBorders")

    for edge in (
        "top",
        "left",
        "bottom",
        "right",
        "insideH",
        "insideV",
    ):
        element = OxmlElement(f"w:{edge}")
        element.set(qn("w:val"), "single")
        element.set(qn("w:sz"), "6")
        element.set(qn("w:space"), "0")
        element.set(qn("w:color"), "000000")
        tbl_borders.append(element)

    tblPr.append(tbl_borders)

    # Pastikan setiap cell juga mempunyai border.
    for row in table.rows:
        for cell in row.cells:

            tcPr = cell._tc.get_or_add_tcPr()

            old_cell_borders = tcPr.find(qn("w:tcBorders"))

            if old_cell_borders is not None:
                tcPr.remove(old_cell_borders)

            cell_borders = OxmlElement("w:tcBorders")

            for edge in (
                "top",
                "left",
                "bottom",
                "right",
            ):
                element = OxmlElement(f"w:{edge}")
                element.set(qn("w:val"), "single")
                element.set(qn("w:sz"), "6")
                element.set(qn("w:space"), "0")
                element.set(qn("w:color"), "000000")
                cell_borders.append(element)

            tcPr.append(cell_borders)


def _replace_lembur_template(doc, values):
    """
    Mengisi template DAFTAR HADIR KERJA LEMBUR
    tanpa merusak struktur tabel asli.
    """

    import re
    from copy import deepcopy

    nama = values.get("NAMA", "")
    nip = values.get("NIP", "")
    unit_kerja = values.get("UNIT_KERJA", "")

    tanggal = (
        values.get("TANGGAL_LEMBUR")
        or values.get("TANGGAL", "")
    )

    tanggal_surat = (
        values.get("TANGGAL_SURAT")
        or values.get("TANGGAL_PEMBUATAN_SURAT")
        or tanggal
    )

    jam_mulai = values.get("JAM_MULAI", "")
    jam_selesai = values.get("JAM_SELESAI", "")

    total = (
        values.get("TOTAL_JAM_LEMBUR")
        or values.get("TOTAL_JAM", "")
    )

    laporan = values.get("LAPORAN_LEMBUR", "")

    def replace_runs(paragraph, replacements):
        """
        Mengganti teks di dalam runs tanpa menghapus
        format paragraph secara keseluruhan.
        """
        for old, new in replacements:
            for run in paragraph.runs:
                if old in run.text:
                    run.text = run.text.replace(
                        old,
                        str(new or "")
                    )

    # =========================================================
    # INFORMASI UNIT KERJA
    # =========================================================

    for paragraph in doc.paragraphs:
        if "Bidang/Unit/Ruangan" in paragraph.text:
            replace_runs(
                paragraph,
                [
                    ("REKAM MEDIS", unit_kerja or "REKAM MEDIS"),
                ]
            )

    # =========================================================
    # NAMA DAN NIP PELAKSANA
    # =========================================================

    for paragraph in doc.paragraphs:
        if "Nama dan NIP" in paragraph.text:
            replace_runs(
                paragraph,
                [
                    ("Hariyadi Adha, S.Pd", nama),
                    ("07012102016113030", nip),
                ]
            )

    # =========================================================
    # TANGGAL PEMBUATAN SURAT
    # =========================================================

    bulan_pattern = (
        r"(?:Januari|Februari|Maret|April|Mei|Juni|Juli|"
        r"Agustus|September|Oktober|November|Desember)"
    )

    for paragraph in doc.paragraphs:
        if "Mengetahui" in paragraph.text and "Barabai" in paragraph.text:

            old_text = paragraph.text

            new_text = re.sub(
                r"(Barabai,\s*)"
                r"\d{1,2}\s+"
                + bulan_pattern +
                r"\s+\d{4}",
                lambda m: m.group(1) + tanggal_surat,
                old_text,
            )

            if new_text != old_text:
                # Pertahankan run pertama sebagai pembawa format.
                if paragraph.runs:
                    paragraph.runs[0].text = new_text

                    for run in paragraph.runs[1:]:
                        run.text = ""
                else:
                    paragraph.text = new_text

    # =========================================================
    # TANDA TANGAN KANAN
    # =========================================================

    for paragraph in doc.paragraphs:

        if (
            "Hj.Siti Salasiah" in paragraph.text
            and "Hariyadi Adha, S.Pd" in paragraph.text
        ):
            replace_runs(
                paragraph,
                [
                    ("Hariyadi Adha, S.Pd", nama),
                ]
            )

        if (
            "NIP. 197307171998032008" in paragraph.text
            and "NIPK. 07012102016113030" in paragraph.text
        ):
            replace_runs(
                paragraph,
                [
                    ("07012102016113030", nip),
                ]
            )

    # =========================================================
    # CARI TABEL UTAMA
    # =========================================================

    target_table = None

    for table in doc.tables:

        if not table.rows:
            continue

        header_text = " ".join(
            cell.text.strip()
            for cell in table.rows[0].cells
        )

        if (
            "Hari/Tanggal" in header_text
            and "Jam Mulai Lembur" in header_text
            and "Jam Selesai Lembur" in header_text
            and "Jumlah Jam Lembur" in header_text
            and "Laporan Lembur" in header_text
        ):
            target_table = table
            break

    if target_table is None:
        raise ValueError(
            "Tabel daftar hadir kerja lembur tidak ditemukan."
        )

    # =========================================================
    # HAPUS TABEL CONTOH TAMBAHAN
    # =========================================================

    for table in list(doc.tables):

        if table is target_table:
            continue

        tbl = table._tbl
        parent = tbl.getparent()

        if parent is not None:
            parent.remove(tbl)

    # =========================================================
    # PERTAHANKAN HEADER DAN SATU BARIS DATA
    # =========================================================

    # Template memiliki header + banyak contoh.
    # Kita hanya mempertahankan baris header dan baris data pertama.
    #
    # Penting:
    # Jangan membuat row baru dengan add_row(),
    # karena itu dapat mengubah format tabel.
    # Kita gunakan row kedua yang sudah memiliki format asli.

    while len(target_table.rows) > 2:

        row_to_remove = target_table.rows[-1]
        target_table._tbl.remove(row_to_remove._tr)

    if len(target_table.rows) < 2:
        raise ValueError(
            "Template tabel lembur harus memiliki minimal "
            "1 header dan 1 baris data."
        )

    data_row = target_table.rows[1]

    # =========================================================
    # ISI DATA TANPA MERUSAK STRUKTUR CELL
    # =========================================================

    data = [
        "1",
        tanggal,
        jam_mulai,
        jam_selesai,
        total,
        laporan,
    ]

    if len(data_row.cells) < 6:
        raise ValueError(
            f"Tabel lembur hanya memiliki "
            f"{len(data_row.cells)} kolom, seharusnya 6 kolom."
        )

    for index, value in enumerate(data):

        cell = data_row.cells[index]

        value = str(value or "")

        # Ambil paragraph pertama yang sudah mempunyai
        # alignment dan formatting template.
        if not cell.paragraphs:
            cell.add_paragraph()

        paragraph = cell.paragraphs[0]

        if paragraph.runs:

            # Pertahankan formatting run pertama.
            paragraph.runs[0].text = value

            # Bersihkan run tambahan saja.
            for run in paragraph.runs[1:]:
                run.text = ""

        else:
            paragraph.text = value

    # =========================================================
    # PASTIKAN JUMLAH BARIS HANYA HEADER + 1 DATA
    # =========================================================

    while len(target_table.rows) > 2:
        target_table._tbl.remove(
            target_table.rows[-1]._tr
        )

    # =========================================================
    # PAKSA BORDER TABEL AGAR TERLIHAT DI WORD
    # =========================================================

    _set_lembur_table_borders(target_table)

    return doc

def render_template(
    template_name,
    output_name,
    values
):

    template = TEMPLATE_DIR / template_name

    if not template.exists():

        raise FileNotFoundError(
            f"Template tidak ditemukan:\n{template}"
        )

    WORD_DIR.mkdir(
        parents=True,
        exist_ok=True
    )

    output = WORD_DIR / output_name

    doc = Document(template)

    # ========================================================
    # TEMPLATE LEMBUR
    # ========================================================

    if template_name.lower() == (
        "daftar hadir kerja lembur.docx"
    ):

        _replace_lembur_template(
            doc,
            values
        )

    else:

        _replace_everywhere(
            doc,
            values
        )

    doc.save(output)

    return output


def find_soffice():

    possible_paths = [

        Path(
            r"C:\Program Files\LibreOffice\program\soffice.exe"
        ),

        Path(
            r"C:\Program Files (x86)\LibreOffice\program\soffice.exe"
        ),

    ]

    for path in possible_paths:

        if path.exists():

            return path

    return None


def create_pdf_from_docx(docx_path):

    docx_path = Path(docx_path)

    if not docx_path.exists():

        return None

    soffice = find_soffice()

    if soffice is None:

        return None

    PDF_DIR.mkdir(
        parents=True,
        exist_ok=True
    )

    pdf_path = (
        PDF_DIR /
        f"{docx_path.stem}.pdf"
    )

    try:

        subprocess.run(
            [
                str(soffice),
                "--headless",
                "--convert-to",
                "pdf",
                "--outdir",
                str(PDF_DIR),
                str(docx_path)
            ],
            capture_output=True,
            text=True,
            timeout=120
        )

        if pdf_path.exists():

            return pdf_path

        return None

    except Exception:

        return None


def today_id():

    return datetime.now().strftime(
        "%Y%m%d_%H%M%S"
    )
