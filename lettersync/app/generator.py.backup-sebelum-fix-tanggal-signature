from pathlib import Path
from docx import Document
from datetime import datetime
import subprocess


BASE_DIR = Path(__file__).resolve().parent.parent

TEMPLATE_DIR = BASE_DIR / "templates"
OUTPUT_DIR = BASE_DIR / "output"

WORD_DIR = OUTPUT_DIR / "word"
PDF_DIR = OUTPUT_DIR / "pdf"


def _replace_in_paragraph(paragraph, replacements):

    for old, new in replacements.items():

        new = str(new or "")

        for run in paragraph.runs:

            if old in run.text:
                run.text = run.text.replace(
                    old,
                    new
                )

        full_text = paragraph.text

        if old in full_text:

            new_text = full_text.replace(
                old,
                new
            )

            if paragraph.runs:

                paragraph.runs[0].text = new_text

                for run in paragraph.runs[1:]:
                    run.text = ""


def _replace_everywhere(doc, replacements):

    for paragraph in doc.paragraphs:

        _replace_in_paragraph(
            paragraph,
            replacements
        )

    for table in doc.tables:

        for row in table.rows:

            for cell in row.cells:

                for paragraph in cell.paragraphs:

                    _replace_in_paragraph(
                        paragraph,
                        replacements
                    )

    for section in doc.sections:

        for paragraph in section.header.paragraphs:

            _replace_in_paragraph(
                paragraph,
                replacements
            )

        for table in section.header.tables:

            for row in table.rows:

                for cell in row.cells:

                    for paragraph in cell.paragraphs:

                        _replace_in_paragraph(
                            paragraph,
                            replacements
                        )

        for paragraph in section.footer.paragraphs:

            _replace_in_paragraph(
                paragraph,
                replacements
            )

        for table in section.footer.tables:

            for row in table.rows:

                for cell in row.cells:

                    for paragraph in cell.paragraphs:

                        _replace_in_paragraph(
                            paragraph,
                            replacements
                        )


def _replace_cell_text(cell, new_text):

    new_text = str(new_text or "")

    if not cell.paragraphs:

        cell.text = new_text
        return

    paragraph = cell.paragraphs[0]

    if paragraph.runs:

        paragraph.runs[0].text = new_text

        for run in paragraph.runs[1:]:

            run.text = ""

    else:

        paragraph.add_run(new_text)


def _cell_text(cell):

    return " ".join(
        line.strip()
        for line in cell.text.splitlines()
        if line.strip()
    )


def _find_table_with_header(doc):

    required = [
        "No",
        "Hari/Tanggal",
        "Jam Mulai Lembur",
        "Jam Selesai Lembur",
        "Jumlah Jam Lembur",
        "Laporan Lembur",
    ]

    for table in doc.tables:

        for row_index, row in enumerate(table.rows):

            texts = [
                _cell_text(cell).lower()
                for cell in row.cells
            ]

            combined = " | ".join(texts)

            score = 0

            for item in required:

                if item.lower() in combined:
                    score += 1

            if score >= 4:

                return table, row_index

    return None, None


def _remove_row(row):

    tbl = row._tr

    tbl.getparent().remove(tbl)


def _replace_lembur_template(doc, values):

    nama = str(
        values.get("NAMA", "")
        or ""
    )

    nip = str(
        values.get("NIP", "")
        or ""
    )

    unit_kerja = str(
        values.get("UNIT_KERJA", "")
        or ""
    )

    tanggal = str(
        values.get("TANGGAL_LEMBUR")
        or values.get("TANGGAL")
        or ""
    )

    jam_mulai = str(
        values.get("JAM_MULAI", "")
        or ""
    )

    jam_selesai = str(
        values.get("JAM_SELESAI", "")
        or ""
    )

    total_jam = str(
        values.get("TOTAL_JAM_LEMBUR")
        or values.get("TOTAL_JAM")
        or ""
    )

    laporan = str(
        values.get("LAPORAN_LEMBUR", "")
        or ""
    ).strip()

    # ========================================================
    # GANTI IDENTITAS PEGAWAI PADA TEMPLATE
    # ========================================================

    replacements = {}

    if nama:

        replacements[
            "Hariyadi Adha, S.Pd"
        ] = nama

    if nip:

        replacements[
            "07012102016113030"
        ] = nip

    if unit_kerja:

        replacements[
            "REKAM MEDIS"
        ] = unit_kerja

    _replace_everywhere(
        doc,
        replacements
    )

    # ========================================================
    # CARI TABEL LEMBUR
    # ========================================================

    table, header_index = _find_table_with_header(
        doc
    )

    if table is None:

        raise ValueError(
            "Tabel lembur tidak ditemukan "
            "di template Word."
        )

    # ========================================================
    # CARI BARIS DATA PERTAMA
    # ========================================================

    data_row_index = None

    for index in range(
        header_index + 1,
        len(table.rows)
    ):

        row = table.rows[index]

        texts = [
            _cell_text(cell)
            for cell in row.cells
        ]

        if not texts:
            continue

        first = texts[0].strip()

        if first.isdigit():

            data_row_index = index
            break

    if data_row_index is None:

        if header_index + 1 < len(table.rows):

            data_row_index = header_index + 1

        else:

            raise ValueError(
                "Baris data lembur tidak ditemukan."
            )

    # ========================================================
    # AMBIL BARIS DATA
    # ========================================================

    data_row = table.rows[data_row_index]

    cells = data_row.cells

    if len(cells) < 6:

        raise ValueError(
            "Kolom tabel lembur kurang dari 6 kolom."
        )

    # ========================================================
    # ISI DATA BARU
    # ========================================================

    _replace_cell_text(
        cells[0],
        "1"
    )

    _replace_cell_text(
        cells[1],
        tanggal
    )

    _replace_cell_text(
        cells[2],
        jam_mulai
    )

    _replace_cell_text(
        cells[3],
        jam_selesai
    )

    _replace_cell_text(
        cells[4],
        total_jam
    )

    _replace_cell_text(
        cells[5],
        laporan
    )

    # ========================================================
    # HAPUS BARIS DATA CONTOH LAIN
    # ========================================================

    rows_to_remove = []

    for index in range(
        header_index + 1,
        len(table.rows)
    ):

        if index == data_row_index:
            continue

        row = table.rows[index]

        texts = [
            _cell_text(cell)
            for cell in row.cells
        ]

        if not texts:
            continue

        first = texts[0].strip()

        if first.isdigit():

            rows_to_remove.append(row)

    for row in rows_to_remove:

        _remove_row(row)

    return doc


def render_template(
    template_name,
    output_name,
    values
):

    template = TEMPLATE_DIR / template_name

    if not template.exists():

        raise FileNotFoundError(
            f"Template tidak ditemukan:\n{template}"
        )

    WORD_DIR.mkdir(
        parents=True,
        exist_ok=True
    )

    output = WORD_DIR / output_name

    doc = Document(template)

    # ========================================================
    # TEMPLATE LEMBUR
    # ========================================================

    if template_name.lower() == (
        "daftar hadir kerja lembur.docx"
    ):

        _replace_lembur_template(
            doc,
            values
        )

    else:

        _replace_everywhere(
            doc,
            values
        )

    doc.save(output)

    return output


def find_soffice():

    possible_paths = [

        Path(
            r"C:\Program Files\LibreOffice\program\soffice.exe"
        ),

        Path(
            r"C:\Program Files (x86)\LibreOffice\program\soffice.exe"
        ),

    ]

    for path in possible_paths:

        if path.exists():

            return path

    return None


def create_pdf_from_docx(docx_path):

    docx_path = Path(docx_path)

    if not docx_path.exists():

        return None

    soffice = find_soffice()

    if soffice is None:

        return None

    PDF_DIR.mkdir(
        parents=True,
        exist_ok=True
    )

    pdf_path = (
        PDF_DIR /
        f"{docx_path.stem}.pdf"
    )

    try:

        subprocess.run(
            [
                str(soffice),
                "--headless",
                "--convert-to",
                "pdf",
                "--outdir",
                str(PDF_DIR),
                str(docx_path)
            ],
            capture_output=True,
            text=True,
            timeout=120
        )

        if pdf_path.exists():

            return pdf_path

        return None

    except Exception:

        return None


def today_id():

    return datetime.now().strftime(
        "%Y%m%d_%H%M%S"
    )
