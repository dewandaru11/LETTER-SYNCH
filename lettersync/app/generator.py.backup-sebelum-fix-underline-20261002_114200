from pathlib import Path
from docx import Document
from datetime import datetime
import subprocess


BASE_DIR = Path(__file__).resolve().parent.parent

TEMPLATE_DIR = BASE_DIR / "templates"
OUTPUT_DIR = BASE_DIR / "output"

WORD_DIR = OUTPUT_DIR / "word"
PDF_DIR = OUTPUT_DIR / "pdf"


def _replace_in_paragraph(paragraph, replacements):

    for old, new in replacements.items():

        new = str(new or "")

        for run in paragraph.runs:

            if old in run.text:
                run.text = run.text.replace(
                    old,
                    new
                )

        full_text = paragraph.text

        if old in full_text:

            new_text = full_text.replace(
                old,
                new
            )

            if paragraph.runs:

                paragraph.runs[0].text = new_text

                for run in paragraph.runs[1:]:
                    run.text = ""


def _replace_everywhere(doc, replacements):

    for paragraph in doc.paragraphs:

        _replace_in_paragraph(
            paragraph,
            replacements
        )

    for table in doc.tables:

        for row in table.rows:

            for cell in row.cells:

                for paragraph in cell.paragraphs:

                    _replace_in_paragraph(
                        paragraph,
                        replacements
                    )

    for section in doc.sections:

        for paragraph in section.header.paragraphs:

            _replace_in_paragraph(
                paragraph,
                replacements
            )

        for table in section.header.tables:

            for row in table.rows:

                for cell in row.cells:

                    for paragraph in cell.paragraphs:

                        _replace_in_paragraph(
                            paragraph,
                            replacements
                        )

        for paragraph in section.footer.paragraphs:

            _replace_in_paragraph(
                paragraph,
                replacements
            )

        for table in section.footer.tables:

            for row in table.rows:

                for cell in row.cells:

                    for paragraph in cell.paragraphs:

                        _replace_in_paragraph(
                            paragraph,
                            replacements
                        )


def _replace_cell_text(cell, new_text):

    new_text = str(new_text or "")

    if not cell.paragraphs:

        cell.text = new_text
        return

    paragraph = cell.paragraphs[0]

    if paragraph.runs:

        paragraph.runs[0].text = new_text

        for run in paragraph.runs[1:]:

            run.text = ""

    else:

        paragraph.add_run(new_text)


def _cell_text(cell):

    return " ".join(
        line.strip()
        for line in cell.text.splitlines()
        if line.strip()
    )


def _find_table_with_header(doc):

    required = [
        "No",
        "Hari/Tanggal",
        "Jam Mulai Lembur",
        "Jam Selesai Lembur",
        "Jumlah Jam Lembur",
        "Laporan Lembur",
    ]

    for table in doc.tables:

        for row_index, row in enumerate(table.rows):

            texts = [
                _cell_text(cell).lower()
                for cell in row.cells
            ]

            combined = " | ".join(texts)

            score = 0

            for item in required:

                if item.lower() in combined:
                    score += 1

            if score >= 4:

                return table, row_index

    return None, None


def _remove_row(row):

    tbl = row._tr

    tbl.getparent().remove(tbl)



def _set_lembur_table_borders(table):
    """Memastikan semua garis tabel lembur tampil di Word."""

    from docx.oxml import OxmlElement
    from docx.oxml.ns import qn

    tbl = table._tbl
    tblPr = tbl.tblPr

    # Hapus konfigurasi border lama jika ada.
    old_borders = tblPr.find(qn("w:tblBorders"))

    if old_borders is not None:
        tblPr.remove(old_borders)

    tbl_borders = OxmlElement("w:tblBorders")

    for edge in (
        "top",
        "left",
        "bottom",
        "right",
        "insideH",
        "insideV",
    ):
        element = OxmlElement(f"w:{edge}")
        element.set(qn("w:val"), "single")
        element.set(qn("w:sz"), "6")
        element.set(qn("w:space"), "0")
        element.set(qn("w:color"), "000000")
        tbl_borders.append(element)

    tblPr.append(tbl_borders)

    # Pastikan setiap cell juga mempunyai border.
    for row in table.rows:
        for cell in row.cells:

            tcPr = cell._tc.get_or_add_tcPr()

            old_cell_borders = tcPr.find(qn("w:tcBorders"))

            if old_cell_borders is not None:
                tcPr.remove(old_cell_borders)

            cell_borders = OxmlElement("w:tcBorders")

            for edge in (
                "top",
                "left",
                "bottom",
                "right",
            ):
                element = OxmlElement(f"w:{edge}")
                element.set(qn("w:val"), "single")
                element.set(qn("w:sz"), "6")
                element.set(qn("w:space"), "0")
                element.set(qn("w:color"), "000000")
                cell_borders.append(element)

            tcPr.append(cell_borders)


def _replace_lembur_template(doc, values):
    """
    Mengisi template daftar hadir lembur.

    Tabel dibuat ulang secara eksplisit agar:
    - 6 kolom selalu terlihat
    - border horizontal terlihat
    - border vertikal terlihat
    - data lama/example hilang
    - tanggal lembur berasal dari input
    """

    import re
    from docx.oxml import OxmlElement
    from docx.oxml.ns import qn

    nama = values.get("NAMA", "")
    nip = values.get("NIP", "")
    unit_kerja = values.get("UNIT_KERJA", "")

    tanggal = (
        values.get("TANGGAL_LEMBUR")
        or values.get("TANGGAL", "")
    )

    tanggal_surat = (
        values.get("TANGGAL_SURAT")
        or values.get("TANGGAL_PEMBUATAN_SURAT")
        or tanggal
    )

    jam_mulai = values.get("JAM_MULAI", "")
    jam_selesai = values.get("JAM_SELESAI", "")

    total = (
        values.get("TOTAL_JAM_LEMBUR")
        or values.get("TOTAL_JAM", "")
    )

    laporan = values.get("LAPORAN_LEMBUR", "")

    # =========================================================
    # HELPER
    # =========================================================

    def replace_runs(paragraph, replacements):
        """
        Mengganti teks pada paragraf Word.

        Jika teks lama terpecah menjadi beberapa runs,
        seluruh isi paragraf akan disusun ulang sehingga
        placeholder tetap dapat diganti.
        """

        if not paragraph.runs:
            return

        original_text = paragraph.text
        new_text = original_text

        for old, new in replacements:
            new_text = new_text.replace(
                old,
                str(new or "")
            )

        if new_text == original_text:
            return

        # Jika perubahan dapat dilakukan langsung pada run,
        # pertahankan formatting yang ada.
        changed = False

        for old, new in replacements:
            for run in paragraph.runs:
                if old in run.text:
                    run.text = run.text.replace(
                        old,
                        str(new or "")
                    )
                    changed = True

        # Jika teks lama ternyata terpecah antar-run,
        # paragraph.text sudah mengandung teks lengkap tetapi
        # tidak ada satu run yang mengandung teks lama utuh.
        if paragraph.text != new_text:
            first_run = paragraph.runs[0]
            first_run.text = new_text

            for run in paragraph.runs[1:]:
                run.text = ""
    def set_cell_border(cell):
        tc = cell._tc
        tcPr = tc.get_or_add_tcPr()

        old = tcPr.find(qn("w:tcBorders"))
        if old is not None:
            tcPr.remove(old)

        borders = OxmlElement("w:tcBorders")

        for edge in ("top", "left", "bottom", "right"):
            element = OxmlElement(f"w:{edge}")
            element.set(qn("w:val"), "single")
            element.set(qn("w:sz"), "8")
            element.set(qn("w:space"), "0")
            element.set(qn("w:color"), "000000")
            borders.append(element)

        tcPr.append(borders)

    def set_cell_width(cell, width_twips):
        tcPr = cell._tc.get_or_add_tcPr()

        tcW = tcPr.find(qn("w:tcW"))

        if tcW is None:
            tcW = OxmlElement("w:tcW")
            tcPr.append(tcW)

        tcW.set(qn("w:w"), str(width_twips))
        tcW.set(qn("w:type"), "dxa")

    def set_cell_text(cell, text, bold=False, center=False):
        cell.text = ""

        paragraph = cell.paragraphs[0]

        if center:
            paragraph.alignment = 1

        run = paragraph.add_run(str(text or ""))
        run.bold = bold

        # Ukuran font tetap sederhana dan konsisten.
        run.font.name = "Arial"
        run.font.size = __import__(
            "docx"
        ).shared.Pt(9)

    # =========================================================
    # INFORMASI UNIT
    # =========================================================

    for paragraph in doc.paragraphs:
        if "Bidang/Unit/Ruangan" in paragraph.text:
            replace_runs(
                paragraph,
                [
                    ("REKAM MEDIS", unit_kerja or "REKAM MEDIS"),
                ]
            )

    # =========================================================
    # NAMA DAN NIP
    # =========================================================

    for paragraph in doc.paragraphs:
        if "Nama dan NIP" in paragraph.text:
            replace_runs(
                paragraph,
                [
                    ("Hariyadi Adha, S.Pd", nama),
                    ("07012102016113030", nip),
                ]
            )

    # =========================================================
    # TANGGAL SURAT
    # =========================================================

    bulan_pattern = (
        r"(?:Januari|Februari|Maret|April|Mei|Juni|Juli|"
        r"Agustus|September|Oktober|November|Desember)"
    )

    for paragraph in doc.paragraphs:

        if "Mengetahui" in paragraph.text and "Barabai" in paragraph.text:

            text = paragraph.text

            new_text = re.sub(
                r"(Barabai,\s*)"
                r"\d{1,2}\s+"
                + bulan_pattern +
                r"\s+\d{4}",
                lambda m: m.group(1) + tanggal_surat,
                text,
            )

            if new_text != text:

                if paragraph.runs:
                    paragraph.runs[0].text = new_text

                    for run in paragraph.runs[1:]:
                        run.text = ""
                else:
                    paragraph.text = new_text

    # =========================================================
    # TANDA TANGAN
    # =========================================================

    for paragraph in doc.paragraphs:

        if (
            "Hj.Siti Salasiah" in paragraph.text
            and "Hariyadi Adha, S.Pd" in paragraph.text
        ):
            replace_runs(
                paragraph,
                [
                    ("Hariyadi Adha, S.Pd", nama),
                ]
            )

        if (
            "NIP. 197307171998032008" in paragraph.text
            and "NIPK. 07012102016113030" in paragraph.text
        ):
            replace_runs(
                paragraph,
                [
                    ("07012102016113030", nip),
                ]
            )

    # =========================================================
    # CARI TABEL UTAMA
    # =========================================================

    target_table = None

    for table in doc.tables:

        if not table.rows:
            continue

        header = " ".join(
            cell.text.strip()
            for cell in table.rows[0].cells
        )

        if (
            "Hari/Tanggal" in header
            and "Jam Mulai Lembur" in header
            and "Jam Selesai Lembur" in header
            and "Jumlah Jam Lembur" in header
            and "Laporan Lembur" in header
        ):
            target_table = table
            break

    if target_table is None:
        raise ValueError(
            "Tabel lembur utama tidak ditemukan."
        )

    # =========================================================
    # HAPUS SEMUA TABEL SELAIN TABEL UTAMA
    # =========================================================

    for table in list(doc.tables):

        if table._tbl is target_table._tbl:
            continue

        tbl = table._tbl
        parent = tbl.getparent()

        if parent is not None:
            parent.remove(tbl)

    # =========================================================
    # HAPUS SEMUA BARIS DATA
    # =========================================================

    tbl = target_table._tbl

    while len(target_table.rows) > 1:
        tbl.remove(target_table.rows[-1]._tr)

    # =========================================================
    # BUAT ROW BARU
    # =========================================================

    row = target_table.add_row()

    # =========================================================
    # PASTIKAN 6 KOLOM
    # =========================================================

    if len(row.cells) != 6:
        raise ValueError(
            f"Tabel lembur membutuhkan 6 kolom, "
            f"tetapi ditemukan {len(row.cells)}."
        )

    # =========================================================
    # DATA
    # =========================================================

    data = [
        "1",
        tanggal,
        jam_mulai,
        jam_selesai,
        total,
        laporan,
    ]

    # Lebar kolom dalam twips.
    #
    # Total sekitar 9000 twips.
    widths = [
        650,
        1450,
        1250,
        1250,
        1150,
        3250,
    ]

    # =========================================================
    # HEADER
    # =========================================================

    header_row = target_table.rows[0]

    headers = [
        "No",
        "Hari/Tanggal",
        "Jam Mulai Lembur",
        "Jam Selesai Lembur",
        "Jumlah Jam Lembur",
        "Laporan Lembur",
    ]

    for i, cell in enumerate(header_row.cells):

        set_cell_width(cell, widths[i])
        set_cell_border(cell)

        set_cell_text(
            cell,
            headers[i],
            bold=True,
            center=True,
        )

    # =========================================================
    # DATA ROW
    # =========================================================

    for i, cell in enumerate(row.cells):

        set_cell_width(cell, widths[i])
        set_cell_border(cell)

        set_cell_text(
            cell,
            data[i],
            bold=False,
            center=(i in (0, 2, 3, 4)),
        )

    # =========================================================
    # BORDER TABEL UTAMA
    # =========================================================

    tblPr = tbl.tblPr

    old_tbl_borders = tblPr.find(qn("w:tblBorders"))

    if old_tbl_borders is not None:
        tblPr.remove(old_tbl_borders)

    tbl_borders = OxmlElement("w:tblBorders")

    for edge in (
        "top",
        "left",
        "bottom",
        "right",
        "insideH",
        "insideV",
    ):
        element = OxmlElement(f"w:{edge}")
        element.set(qn("w:val"), "single")
        element.set(qn("w:sz"), "8")
        element.set(qn("w:space"), "0")
        element.set(qn("w:color"), "000000")
        tbl_borders.append(element)

    tblPr.append(tbl_borders)

    return doc

def render_template(
    template_name,
    output_name,
    values
):

    template = TEMPLATE_DIR / template_name

    if not template.exists():

        raise FileNotFoundError(
            f"Template tidak ditemukan:\n{template}"
        )

    WORD_DIR.mkdir(
        parents=True,
        exist_ok=True
    )

    output = WORD_DIR / output_name

    doc = Document(template)

    # ========================================================
    # TEMPLATE LEMBUR
    # ========================================================

    if template_name.lower() == (
        "daftar hadir kerja lembur.docx"
    ):

        _replace_lembur_template(
            doc,
            values
        )

    else:

        _replace_everywhere(
            doc,
            values
        )

    doc.save(output)

    return output


def find_soffice():

    possible_paths = [

        Path(
            r"C:\Program Files\LibreOffice\program\soffice.exe"
        ),

        Path(
            r"C:\Program Files (x86)\LibreOffice\program\soffice.exe"
        ),

    ]

    for path in possible_paths:

        if path.exists():

            return path

    return None


def create_pdf_from_docx(docx_path):

    docx_path = Path(docx_path)

    if not docx_path.exists():

        return None

    soffice = find_soffice()

    if soffice is None:

        return None

    PDF_DIR.mkdir(
        parents=True,
        exist_ok=True
    )

    pdf_path = (
        PDF_DIR /
        f"{docx_path.stem}.pdf"
    )

    try:

        subprocess.run(
            [
                str(soffice),
                "--headless",
                "--convert-to",
                "pdf",
                "--outdir",
                str(PDF_DIR),
                str(docx_path)
            ],
            capture_output=True,
            text=True,
            timeout=120
        )

        if pdf_path.exists():

            return pdf_path

        return None

    except Exception:

        return None


def today_id():

    return datetime.now().strftime(
        "%Y%m%d_%H%M%S"
    )
