from datetime import datetime
import subprocess


BASE_DIR = Path(__file__).resolve().parent.parent

TEMPLATE_DIR = BASE_DIR / "templates"
OUTPUT_DIR = BASE_DIR / "output"

WORD_DIR = OUTPUT_DIR / "word"
PDF_DIR = OUTPUT_DIR / "pdf"


def _replace_in_paragraph(paragraph, replacements):

    for old, new in replacements.items():

        new = str(new or "")

        for run in paragraph.runs:

            if old in run.text:
                run.text = run.text.replace(
                    old,
                    new
                )

        full_text = paragraph.text

        if old in full_text:

            new_text = full_text.replace(
                old,
                new
            )

            if paragraph.runs:

                paragraph.runs[0].text = new_text

                for run in paragraph.runs[1:]:
                    run.text = ""


def _replace_everywhere(doc, replacements):

    for paragraph in doc.paragraphs:

        _replace_in_paragraph(
            paragraph,
            replacements
        )

    for table in doc.tables:

        for row in table.rows:

            for cell in row.cells:

                for paragraph in cell.paragraphs:

                    _replace_in_paragraph(
                        paragraph,
                        replacements
                    )

    for section in doc.sections:

        for paragraph in section.header.paragraphs:

            _replace_in_paragraph(
                paragraph,
                replacements
            )

        for table in section.header.tables:

            for row in table.rows:

                for cell in row.cells:

                    for paragraph in cell.paragraphs:

                        _replace_in_paragraph(
                            paragraph,
                            replacements
                        )

        for paragraph in section.footer.paragraphs:

            _replace_in_paragraph(
                paragraph,
                replacements
            )

        for table in section.footer.tables:

            for row in table.rows:

                for cell in row.cells:

                    for paragraph in cell.paragraphs:

                        _replace_in_paragraph(
                            paragraph,
                            replacements
                        )


def _replace_cell_text(cell, new_text):

    new_text = str(new_text or "")

    if not cell.paragraphs:

        cell.text = new_text
        return

    paragraph = cell.paragraphs[0]

    if paragraph.runs:

        paragraph.runs[0].text = new_text

        for run in paragraph.runs[1:]:

            run.text = ""

    else:

        paragraph.add_run(new_text)


def _cell_text(cell):

    return " ".join(
        line.strip()
        for line in cell.text.splitlines()
        if line.strip()
    )


def _find_table_with_header(doc):

    required = [
        "No",
        "Hari/Tanggal",
        "Jam Mulai Lembur",
        "Jam Selesai Lembur",
        "Jumlah Jam Lembur",
        "Laporan Lembur",
    ]

    for table in doc.tables:

        for row_index, row in enumerate(table.rows):

            texts = [
                _cell_text(cell).lower()
                for cell in row.cells
            ]

            combined = " | ".join(texts)

            score = 0

            for item in required:

                if item.lower() in combined:
                    score += 1

            if score >= 4:

                return table, row_index

    return None, None


def _remove_row(row):

    tbl = row._tr

    tbl.getparent().remove(tbl)


def _replace_lembur_template(doc, values):
    """
    Mengisi template DAFTAR HADIR KERJA LEMBUR yang berupa
    template contoh jadi, bukan template placeholder.
    """

    nama = str(values.get("NAMA") or "")
    nip = str(values.get("NIP") or "")
    unit_kerja = str(values.get("UNIT_KERJA") or "")

    tanggal = str(
        values.get("TANGGAL_LEMBUR")
        or values.get("TANGGAL")
        or ""
    )

    tanggal_surat = str(
        values.get("TANGGAL_PEMBUATAN_SURAT")
        or values.get("TANGGAL_SURAT")
        or ""
    )

    jam_mulai = str(values.get("JAM_MULAI") or "")
    jam_selesai = str(values.get("JAM_SELESAI") or "")

    total = str(
        values.get("TOTAL_JAM_LEMBUR")
        or values.get("TOTAL_JAM")
        or ""
    )

    laporan = str(
        values.get("LAPORAN_LEMBUR")
        or ""
    )

    # --------------------------------------------------------
    # Helper penggantian teks pada run agar format Word
    # (underline, font, ukuran, dll.) tetap dipertahankan.
    # --------------------------------------------------------
    def replace_in_paragraph_runs(paragraph, old, new):
        changed = False

        for run in paragraph.runs:
            if old in run.text:
                run.text = run.text.replace(old, new)
                changed = True

        return changed

    def replace_everywhere_preserve_format(old, new):
        for paragraph in doc.paragraphs:
            replace_in_paragraph_runs(
                paragraph,
                old,
                new,
            )

        for table in doc.tables:
            for row in table.rows:
                for cell in row.cells:
                    for paragraph in cell.paragraphs:
                        replace_in_paragraph_runs(
                            paragraph,
                            old,
                            new,
                        )

    # --------------------------------------------------------
    # Helper iterasi semua paragraph termasuk yang berada
    # di dalam tabel.
    # --------------------------------------------------------
    def all_paragraphs():
        for paragraph in doc.paragraphs:
            yield paragraph

        for table in doc.tables:
            for row in table.rows:
                for cell in row.cells:
                    for paragraph in cell.paragraphs:
                        yield paragraph

    # --------------------------------------------------------
    # Data header
    # --------------------------------------------------------

    # Unit kerja
    replace_everywhere_preserve_format(
        "REKAM MEDIS",
        unit_kerja,
    )

    # Nama/NIP pegawai hanya diganti pada bagian tanda tangan
    # kanan, bukan seluruh dokumen.
    #
    # Template lama:
    # Hariyadi Adha, S.Pd
    # NIPK. 07012102016113030
    #
    # Penggantian dilakukan pada paragraph yang berhubungan
    # dengan "Pelaksana Kerja Lembur".
    paragraphs = list(all_paragraphs())

    signature_index = None

    for i, paragraph in enumerate(paragraphs):
        text = paragraph.text.strip()

        if "Pelaksana Kerja Lembur" in text:
            signature_index = i
            break

    if signature_index is not None:

        # Biasanya nama berada pada paragraph berikutnya.
        for paragraph in paragraphs[
            signature_index + 1:
            signature_index + 4
        ]:
            replace_in_paragraph_runs(
                paragraph,
                "Hariyadi Adha, S.Pd",
                nama,
            )

            replace_in_paragraph_runs(
                paragraph,
                "07012102016113030",
                nip,
            )

    # Fallback jika nama ternyata berada di struktur lain.
    # Hanya dilakukan jika nama contoh masih ditemukan.
    if any(
        "Hariyadi Adha, S.Pd" in p.text
        for p in paragraphs
    ):
        for paragraph in paragraphs:
            if (
                "Pelaksana Kerja Lembur" in paragraph.text
                or "Hariyadi Adha, S.Pd" in paragraph.text
            ):
                replace_in_paragraph_runs(
                    paragraph,
                    "Hariyadi Adha, S.Pd",
                    nama,
                )
                replace_in_paragraph_runs(
                    paragraph,
                    "07012102016113030",
                    nip,
                )

    # --------------------------------------------------------
    # Tanggal pembuatan surat
    # --------------------------------------------------------
    if tanggal_surat:
        # Mengganti tanggal contoh:
        # Barabai, 28 Maret  2026
        #
        # Tetap mempertahankan "Barabai," dan format paragraph.
        date_pattern = re.compile(
            r"(Barabai,\s*)"
            r"\d{1,2}\s+"
            r"(?:Januari|Februari|Maret|April|Mei|Juni|"
            r"Juli|Agustus|September|Oktober|November|Desember)"
            r"\s+\d{4}"
        )

        for paragraph in all_paragraphs():
            for run in paragraph.runs:
                if "Barabai," in run.text:
                    run.text = date_pattern.sub(
                        r"\1" + tanggal_surat,
                        run.text,
                    )

    # --------------------------------------------------------
    # Cari tabel utama lembur
    # --------------------------------------------------------
    required_headers = {
        "no",
        "hari/tanggal",
        "jam mulai lembur",
        "jam selesai lembur",
        "jumlah jam lembur",
        "laporan lembur",
    }

    target_table = None
    header_row_index = None

    for table in doc.tables:
        for row_index, row in enumerate(table.rows):
            texts = [
                cell.text.strip().lower()
                for cell in row.cells
            ]

            found = 0

            for header in required_headers:
                if any(header in text for text in texts):
                    found += 1

            if found >= 4:
                target_table = table
                header_row_index = row_index
                break

        if target_table is not None:
            break

    if target_table is None:
        raise ValueError(
            "Tabel lembur tidak ditemukan pada template."
        )

    # --------------------------------------------------------
    # Cari baris data pertama
    # --------------------------------------------------------
    data_row_index = None

    for index in range(
        header_row_index + 1,
        len(target_table.rows),
    ):
        row = target_table.rows[index]

        first_cell = row.cells[0].text.strip()

        if first_cell.isdigit():
            data_row_index = index
            break

    if data_row_index is None:
        raise ValueError(
            "Baris data lembur tidak ditemukan."
        )

    # --------------------------------------------------------
    # Hapus semua baris contoh setelah baris data pertama.
    # --------------------------------------------------------
    def remove_row(row):
        tbl = row._tr
        tbl.getparent().remove(tbl)

    while len(target_table.rows) > data_row_index + 1:
        remove_row(
            target_table.rows[data_row_index + 1]
        )

    # --------------------------------------------------------
    # Isi satu-satunya baris lembur
    # --------------------------------------------------------
    row = target_table.rows[data_row_index]

    cells = row.cells

    if len(cells) >= 6:

        cells[0].text = "1"
        cells[1].text = tanggal
        cells[2].text = jam_mulai
        cells[3].text = jam_selesai
        cells[4].text = total
        cells[5].text = laporan

    # --------------------------------------------------------
    # Perbaikan tampilan tanda tangan.
    #
    # Jangan mengubah paragraph menjadi paragraph.text baru
    # karena itu dapat menghilangkan underline/font asli.
    #
    # Nama kanan tetap berada di bawah "Pelaksana Kerja Lembur".
    # --------------------------------------------------------

    # Bersihkan spasi/tab berlebihan hanya pada paragraph judul
    # jika template menggunakan tab panjang.
    for paragraph in paragraphs:
        if "Pelaksana Teknis Kegiatan" in paragraph.text:
            for run in paragraph.runs:
                text = run.text
                text = text.replace(
                    "\t\t\t\t\t\t",
                    "\t\t",
                )
                run.text = text

    return doc

def render_template(
    template_name,
    output_name,
    values
):

    template = TEMPLATE_DIR / template_name

    if not template.exists():

        raise FileNotFoundError(
            f"Template tidak ditemukan:\n{template}"
        )

    WORD_DIR.mkdir(
        parents=True,
        exist_ok=True
    )

    output = WORD_DIR / output_name

    doc = Document(template)

    # ========================================================
    # TEMPLATE LEMBUR
    # ========================================================

    if template_name.lower() == (
        "daftar hadir kerja lembur.docx"
    ):

        _replace_lembur_template(
            doc,
            values
        )

    else:

        _replace_everywhere(
            doc,
            values
        )

    doc.save(output)

    return output


def find_soffice():

    possible_paths = [

        Path(
            r"C:\Program Files\LibreOffice\program\soffice.exe"
        ),

        Path(
            r"C:\Program Files (x86)\LibreOffice\program\soffice.exe"
        ),

    ]

    for path in possible_paths:

        if path.exists():

            return path

    return None


def create_pdf_from_docx(docx_path):

    docx_path = Path(docx_path)

    if not docx_path.exists():

        return None

    soffice = find_soffice()

    if soffice is None:

        return None

    PDF_DIR.mkdir(
        parents=True,
        exist_ok=True
    )

    pdf_path = (
        PDF_DIR /
        f"{docx_path.stem}.pdf"
    )

    try:

        subprocess.run(
            [
                str(soffice),
                "--headless",
                "--convert-to",
                "pdf",
                "--outdir",
                str(PDF_DIR),
                str(docx_path)
            ],
            capture_output=True,
            text=True,
            timeout=120
        )

        if pdf_path.exists():

            return pdf_path

        return None

    except Exception:

        return None


