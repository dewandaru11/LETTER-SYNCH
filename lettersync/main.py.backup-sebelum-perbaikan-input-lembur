    def update_lembur_duration(self):
        """Menghitung rentang dan total jam lembur secara otomatis."""

        start = self.lembur_start.time()
        end = self.lembur_end.time()

        start_minutes = start.hour() * 60 + start.minute()
        end_minutes = end.hour() * 60 + end.minute()

        # Jika melewati tengah malam, anggap selesai pada hari berikutnya.
        if end_minutes < start_minutes:
            end_minutes += 24 * 60

        duration = end_minutes - start_minutes

        hours = duration // 60
        minutes = duration % 60

        self.lembur_range.setText(
            f"{start.toString('HH:mm')} s.d {end.toString('HH:mm')}"
        )

        if minutes == 0:
            total_text = f"{hours} jam"
        else:
            total_text = f"{hours} jam {minutes} menit"

        self.lembur_total.setText(total_text)


    def save_lembur(self):
        """Membuat dokumen daftar hadir kerja lembur."""

        employee_id = self.lembur_employee_combo.currentData()

        if not employee_id:
            QMessageBox.warning(
                self,
                "Data Belum Lengkap",
                "Silakan pilih pegawai terlebih dahulu."
            )
            return

        tanggal = self.lembur_date.date()
        tanggal_iso = tanggal.toString("yyyy-MM-dd")

        tanggal_text = (
            f"{tanggal.day()} "
            f"{BULAN_ID[tanggal.month() - 1]} "
            f"{tanggal.year()}"
        )

        jam_mulai = self.lembur_start.time().toString("HH:mm")
        jam_selesai = self.lembur_end.time().toString("HH:mm")
        rentang = self.lembur_range.text()
        total = self.lembur_total.text()

        # Laporan sengaja tidak diberi nilai otomatis.
        laporan = self.lembur_report.toPlainText()

        conn = get_connection()
        row = conn.execute("""
            SELECT *
            FROM pegawai
            WHERE id = ?
        """, (employee_id,)).fetchone()
        conn.close()

        if not row:
            QMessageBox.warning(
                self,
                "Data Tidak Ditemukan",
                "Data pegawai tidak ditemukan."
            )
            return

        nama = row["nama"] or ""
        nip = row["nip"] or ""
        jabatan = row["jabatan"] or ""
        unit_kerja = row["unit_kerja"] or ""

        template_name = "DAFTAR HADIR KERJA LEMBUR.docx"
        template_path = TEMPLATE_DIR / template_name

        if not template_path.exists():
            QMessageBox.information(
                self,
                "Template Belum Ada",
                "Form Lembur sudah siap digunakan.\n\n"
                f"Silakan masukkan template:\n"
                f"{template_name}\n\n"
                f"ke folder:\n{TEMPLATE_DIR}"
            )
            return

        values = {
            "NAMA": nama,
            "NIP": nip,
            "JABATAN": jabatan,
            "UNIT_KERJA": unit_kerja,
            "TANGGAL": tanggal_text,
            "TANGGAL_LEMBUR": tanggal_text,
            "JAM_MULAI": jam_mulai,
            "JAM_SELESAI": jam_selesai,
            "RENTANG_JAM": rentang,
            "RENTANG_JAM_LEMBUR": rentang,
            "TOTAL_JAM": total,
            "TOTAL_JAM_LEMBUR": total,
            "LAPORAN_LEMBUR": laporan,
        }

        safe_name = "".join(
            c for c in nama
            if c.isalnum() or c in " _-"
        ).strip()

        if not safe_name:
            safe_name = "Pegawai"

        output_name = (
            f"Lembur_{tanggal_iso}_{safe_name}"
            .replace(" ", "_")
        )

        def work():
            docx_path = render_template(
                template_name,
                output_name + ".docx",
                values
            )

            pdf_path = create_pdf_from_docx(docx_path)

            conn = get_connection()

            conn.execute("""
                INSERT INTO lembur (
                    pegawai_id,
                    tanggal,
                    jam_mulai,
                    jam_selesai,
                    rentang_jam,
                    total_jam,
                    laporan_lembur,
                    status,
                    file_path,
                    pdf_path
                )
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            """, (
                employee_id,
                tanggal_iso,
                jam_mulai,
                jam_selesai,
                rentang,
                total,
                laporan,
                "Selesai",
                str(docx_path),
                str(pdf_path) if pdf_path else None
            ))

            conn.commit()
            conn.close()

            return {
                "word": str(docx_path),
                "pdf": str(pdf_path) if pdf_path else ""
            }

        self.start_letter_worker(work, self.l_save_button)

