    def load_archive(self):

        if not hasattr(
            self,
            "archive_table"
        ):
            return

        conn = get_connection()
        cur = conn.cursor()

        cur.execute("""
            SELECT
                surat.id,
                surat.jenis,
                pegawai.nama AS pegawai,
                surat.tanggal_surat,
                surat.status,
                surat.file_path,
                surat.pdf_path,
                surat.created_at
            FROM surat
            LEFT JOIN pegawai
                ON pegawai.id = surat.pegawai_id
            ORDER BY surat.id DESC
        """)

        rows = cur.fetchall()

        conn.close()

        self.archive_table.setRowCount(
            len(rows)
        )

        for r, row in enumerate(rows):

            values = [
                row["id"],
                row["jenis"],
                row["pegawai"] or "",
                row["tanggal_surat"] or "",
                row["status"] or "",
                row["file_path"] or "",
                row["pdf_path"] or "",
                row["created_at"] or "",
            ]

            for c, value in enumerate(values):

                item = QTableWidgetItem(
                    str(value)
                )

                self.archive_table.setItem(
                    r,
                    c,
                    item
                )

