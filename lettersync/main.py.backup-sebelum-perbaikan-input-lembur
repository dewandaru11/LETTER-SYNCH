# ============================================================
# FORMAT TANGGAL
# ============================================================

def parse_date(value):
    if isinstance(value, date):
        return value

    if not value:
        return date.today()

    value = str(value).strip()

    for fmt in ("%d-%m-%Y", "%d/%m/%Y", "%Y-%m-%d"):
        try:
            return datetime.strptime(value, fmt).date()
        except ValueError:
            pass

    raise ValueError(f"Format tanggal tidak dikenali: {value}")


def format_date_id(value):
    d = parse_date(value)
    return f"{d.day} {BULAN_ID[d.month - 1]} {d.year}"


def format_day_id(value):
    d = parse_date(value)
    return HARI_ID[d.weekday()]


def format_range_day(start, end):
    start = parse_date(start)
    end = parse_date(end)

    if start == end:
        return HARI_ID[start.weekday()]

    return f"{HARI_ID[start.weekday()]} s.d {HARI_ID[end.weekday()]}"


def format_range_date(start, end):
    start = parse_date(start)
    end = parse_date(end)

    if start == end:
        return format_date_id(start)

    return f"{format_date_id(start)} s.d {format_date_id(end)}"


def count_workdays(start, end):
    start = parse_date(start)
    end = parse_date(end)

    if end < start:
        start, end = end, start

    total = 0
    current = start

    while current <= end:
        if current.weekday() < 5:
            total += 1
        current += timedelta(days=1)

    return total


